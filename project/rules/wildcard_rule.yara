

rule wildcard_rule
{
	meta:
        writter="written by Ajoy and Rafi"
        date="02-03-2024"
	strings:
		$0 = {00 00 ?? 01 00 00 ?? 02}
		$1 = {00 00 ?? 00 00 00 ?? 01}
		$2 = {0A ?? 01}
		$13 = {59 ?? ?? 00 00 00}
	condition:
		$0 at entrypoint or $1 or $2 or $13
}

rule Powerful_wildcard_rule
{
	meta:
        writter="written by Ajoy and Rafi"
        date="02-03-2024"
        description = "Powerful wildcards with not operator"
	strings:
		
		$15 = {~55 00 00 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 ?? ?? 00 ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00 ?? ?? ?? ?? ?? ?? ?? 00 ?? ?? ?? ?? ?? ?? 00 00 00 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00}
		
	condition:
		$15 
}

