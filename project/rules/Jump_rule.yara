rule Jump
{
	meta:
        writter="written by Ajoy and Rafi"
        date="02-03-2024"
        description = "Bounded Jump"
	strings:
		
		$6 = {00 [49-60] 00 ?? ?? ?? 0D ?? ?? ?? 00 [10-20] 00}
	condition:
		$6
}

rule Powerful_wildcard_rule
{
	meta:
        writter="written by Ajoy and Rafi"
        date="02-03-2024"
        description = "Unbounded Jump"
	strings:
		
		$15 = {00 00 [11-] 00 ?? ?? 00 ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00 ?? ?? ?? ?? ?? ?? ?? 00 ?? ?? ?? ?? ?? ?? 00 00 00 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 00 00}
		
	condition:
		$15 
}